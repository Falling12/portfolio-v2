# If using the bundled docker-compose Postgres: postgresql://postgres:postgres@127.0.0.1:5432/portfolio_v2
# If using a local Postgres install with peer auth, drop the user:pass — postgresql://127.0.0.1:5432/portfolio_v2
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/portfolio_v2
PAYLOAD_SECRET=YOUR_SECRET_HERE
NEXT_PUBLIC_SERVER_URL=http://localhost:3010
